{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "creativeProcess": {
      "type": "blocks"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project-category.project-category",
      "inversedBy": "projects"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "videos"]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "videos"]
    },
    "projectVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "videos"]
    },
    "videoUrl": {
      "type": "string"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "videos"]
    },
    "technologies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.technology"
    },
    "projectDate": {
      "type": "date"
    },
    "projectType": {
      "type": "enumeration",
      "enum": ["automation", "web", "film", "3d", "motion", "experimental"]
    },
    "clientName": {
      "type": "string"
    },
    "externalLink": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    }
  }
}

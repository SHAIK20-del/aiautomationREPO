{
  "name": "living-atelier",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "npm run dev -w @atelier/web",
    "dev:cms": "npm run develop -w @atelier/cms",
    "build": "npm run build -w @atelier/web",
    "build:cms": "npm run build -w @atelier/cms",
    "typecheck": "npm run typecheck -w @atelier/web",
    "test": "node --import tsx tests/security.test.ts && node --import tsx packages/database/tests/inquiries.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "npm run generate -w @atelier/database",
    "db:migrate": "npm run migrate -w @atelier/database",
    "format": "prettier --write apps/web/src apps/cms/config apps/cms/src packages/*/src tests playwright.config.ts README.md docs",
    "test:cms-contract": "node --test tests/cms-contract.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.56.0",
    "node": "^22.23.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "markdown-it@^14.0.0": "14.3.3",
    "undici@^8.0.0": "8.12.3",
    "vite@^6.0.0": "6.4.5",
    "zod@^4.0.0": "4.6.7"
  }
}
